<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Script file="ListScrollFrame.lua"/>

	<!-- Native-widget AchieverHybridScrollFrame replacement: same template names and
	     Lua function contract AchievementUI.xml/.lua already use, built from
	     confirmed vanilla-native textures/widgets instead of a WotLK port. -->

	<Texture name="AchieverHybridScrollBarButton" virtual="true">
		<TexCoords left="0.25" right="0.75" top="0.25" bottom="0.75"/>
	</Texture>

	<Slider name="AchieverHybridScrollBarTemplate" virtual="true">
		<Size>
			<AbsDimension x="20" y="0"/>
		</Size>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBG" setAllPoints="true" hidden="true">
					<Color r="0" g="0" b="0" a="0.85"/>
				</Texture>
			</Layer>
			<!-- Decorative track: without this, the trough behind the thumb is
			     plain transparent space, which reads as a gap next to the
			     scrollbar's narrower buttons/thumb. Same confirmed vanilla-native
			     texture and TexCoords as ReputationFrame.xml/MailFrame.xml's own
			     scrollbars, not a WotLK-only asset. -->
			<Layer level="ARTWORK">
				<Texture name="$parentTop" file="Interface\PaperDollInfoFrame\UI-Character-ScrollBar">
					<Size>
						<AbsDimension x="27" y="48"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="-4" y="17"/>
							</Offset>
						</Anchor>
					</Anchors>
					<TexCoords left="0" right="0.484375" top="0" bottom=".20"/>
				</Texture>
				<Texture name="$parentBottom" file="Interface\PaperDollInfoFrame\UI-Character-ScrollBar">
					<Size>
						<AbsDimension x="27" y="64"/>
					</Size>
					<Anchors>
						<Anchor point="BOTTOMLEFT">
							<Offset>
								<AbsDimension x="-4" y="-15"/>
							</Offset>
						</Anchor>
					</Anchors>
					<TexCoords left="0.515625" right="1.0" top="0.1440625" bottom="0.4140625"/>
				</Texture>
				<Texture name="$parentMiddle" file="Interface\PaperDollInfoFrame\UI-Character-ScrollBar">
					<Anchors>
						<Anchor point="TOPLEFT" relativeTo="$parentTop" relativePoint="BOTTOMLEFT"/>
						<Anchor point="BOTTOMRIGHT" relativeTo="$parentBottom" relativePoint="TOPRIGHT"/>
					</Anchors>
					<TexCoords left="0" right="0.484375" top="0.1640625" bottom="1"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentScrollUpButton">
				<Size>
					<AbsDimension x="16" y="16"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOM" relativePoint="TOP">
						<Offset>
							<AbsDimension x="0" y="-2"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture inherits="AchieverHybridScrollBarButton" file="Interface\Buttons\UI-ScrollBar-ScrollUpButton-Up"/>
				<PushedTexture inherits="AchieverHybridScrollBarButton" file="Interface\Buttons\UI-ScrollBar-ScrollUpButton-Down"/>
				<DisabledTexture inherits="AchieverHybridScrollBarButton" file="Interface\Buttons\UI-ScrollBar-ScrollUpButton-Disabled"/>
				<HighlightTexture inherits="AchieverHybridScrollBarButton" file="Interface\Buttons\UI-ScrollBar-ScrollUpButton-Highlight" alphaMode="ADD"/>
				<Scripts>
					<OnLoad>
						local this = self or this;
						this:GetParent():GetParent().scrollUp = this;
						this:RegisterForClicks("LeftButtonUp", "LeftButtonDown");
						this:EnableMouseWheel(true);
						-- Attached here (not left as this element's own inline
						-- OnMouseWheel body below, now dead code) since arg1
						-- isn't reliably bound in inline script bodies beyond
						-- self -- see ListScrollFrame.lua's matching
						-- AchieverHybridScrollFrameScrollBar_OnLoad fix for the full
						-- explanation.
						this:SetScript("OnMouseWheel", function(btn, delta)
							btn = btn or this;
							delta = delta or arg1;
							AchieverHybridScrollFrame_OnMouseWheel(btn:GetParent():GetParent(), delta);
						end);
					</OnLoad>
					<OnClick>
						local this = self or this;
						local scrollFrame = this:GetParent():GetParent();
						AchieverHybridScrollFrame_OnMouseWheel(scrollFrame, 1);
					</OnClick>
					<OnMouseWheel>
						local this = self or this;
						AchieverHybridScrollFrame_OnMouseWheel(this:GetParent():GetParent(), arg1);
					</OnMouseWheel>
				</Scripts>
			</Button>
			<Button name="$parentScrollDownButton">
				<Size>
					<AbsDimension x="16" y="16"/>
				</Size>
				<Anchors>
					<Anchor point="TOP" relativePoint="BOTTOM">
						<Offset>
							<AbsDimension x="0" y="2"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture inherits="AchieverHybridScrollBarButton" file="Interface\Buttons\UI-ScrollBar-ScrollDownButton-Up"/>
				<PushedTexture inherits="AchieverHybridScrollBarButton" file="Interface\Buttons\UI-ScrollBar-ScrollDownButton-Down"/>
				<DisabledTexture inherits="AchieverHybridScrollBarButton" file="Interface\Buttons\UI-ScrollBar-ScrollDownButton-Disabled"/>
				<HighlightTexture inherits="AchieverHybridScrollBarButton" file="Interface\Buttons\UI-ScrollBar-ScrollDownButton-Highlight" alphaMode="ADD"/>
				<Scripts>
					<OnLoad>
						local this = self or this;
						this:GetParent():GetParent().scrollDown = this;
						this:RegisterForClicks("LeftButtonUp", "LeftButtonDown");
						this:EnableMouseWheel(true);
						-- See ScrollUpButton's matching OnLoad comment above.
						this:SetScript("OnMouseWheel", function(btn, delta)
							btn = btn or this;
							delta = delta or arg1;
							AchieverHybridScrollFrame_OnMouseWheel(btn:GetParent():GetParent(), delta);
						end);
					</OnLoad>
					<OnClick>
						local this = self or this;
						local scrollFrame = this:GetParent():GetParent();
						AchieverHybridScrollFrame_OnMouseWheel(scrollFrame, -1);
					</OnClick>
					<OnMouseWheel>
						local this = self or this;
						AchieverHybridScrollFrame_OnMouseWheel(this:GetParent():GetParent(), arg1);
					</OnMouseWheel>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				AchieverHybridScrollFrameScrollBar_OnLoad(self);
			</OnLoad>
			<OnValueChanged>
				local this = self or this;
				AchieverHybridScrollFrame_OnValueChanged(this:GetParent(), arg1);
			</OnValueChanged>
			<OnMouseWheel>
				local this = self or this;
				AchieverHybridScrollFrame_OnMouseWheel(this:GetParent(), arg1);
			</OnMouseWheel>
		</Scripts>
		<ThumbTexture name="$parentThumbTexture" inherits="AchieverHybridScrollBarButton" file="Interface\Buttons\UI-ScrollBar-Knob" parentKey="thumbTexture">
			<Size>
				<AbsDimension x="16" y="24"/>
			</Size>
			<TexCoords left="0.25" right="0.75" top="0.125" bottom="0.875"/>
		</ThumbTexture>
	</Slider>

	<ScrollFrame name="AchieverHybridScrollFrameTemplate" virtual="true">
		<Scripts>
			<OnLoad>
				AchieverHybridScrollFrame_OnLoad(self);
			</OnLoad>
			<OnMouseWheel>
				AchieverHybridScrollFrame_OnMouseWheel(self or this, arg1);
			</OnMouseWheel>
		</Scripts>
		<ScrollChild>
			<Frame name="$parentScrollChild">
				<Scripts>
					<OnLoad>
						AchieverHybridScrollFrameScrollChild_OnLoad(self);
					</OnLoad>
				</Scripts>
			</Frame>
		</ScrollChild>
	</ScrollFrame>

	<ScrollFrame name="AchieverBasicHybridScrollFrameTemplate" inherits="AchieverHybridScrollFrameTemplate" virtual="true">
		<Anchors>
			<Anchor point="TOPLEFT"/>
			<Anchor point="BOTTOMRIGHT"/>
		</Anchors>
		<Frames>
			<Slider name="$parentScrollBar" inherits="AchieverHybridScrollBarTemplate"/>
		</Frames>
	</ScrollFrame>
</Ui>
